# === Runtime Mode & Networking ===
NODE_ENV=production
PREVIEWFLOW_MODE=all
PORT=4000
TRUST_PROXY=1

# === Database ===
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/previewflow?sslmode=require"

# === Cryptographic Secrets (minimum 32 random characters each in production) ===
JWT_SECRET="replace_with_at_least_32_random_characters_for_jwt"
ENCRYPTION_KEY="replace_with_at_least_32_random_characters_for_aes"
# Optional zero-downtime key rotation fallbacks
# JWT_SECRET_PREVIOUS=""
# ENCRYPTION_KEY_PREVIOUS=""

# === GitHub OAuth ===
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
GITHUB_CALLBACK_URL="https://app.previewflow.example.com/auth/github/callback"

# === CORS & URLs ===
FRONTEND_URL="https://app.previewflow.example.com"
ALLOWED_ORIGINS="https://app.previewflow.example.com"
PUBLIC_WEBHOOK_URL="https://app.previewflow.example.com"
PREVIEW_BASE_DOMAIN="previews.previewflow.example.com"
PREVIEW_URL_PROTOCOL="https"
# PREVIEW_UPSTREAM_HOST="127.0.0.1"

# === Observability, Proxy & Alerts ===
LOG_LEVEL="info"
# METRICS_TOKEN="replace_with_prometheus_scrape_bearer_token"
# INTERNAL_PROXY_TOKEN="replace_with_internal_proxy_shared_secret"
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."

# === Backups & Disaster Recovery ===
# BACKUP_ENCRYPTION_KEY="replace_with_dedicated_32_char_backup_key"
BACKUP_DIR="./backups"
