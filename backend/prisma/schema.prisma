generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTier {
  FREE
  HOBBY
  PRO
  ENTERPRISE
}

enum BuildStatus {
  QUEUED
  RUNNING
  RETRYING
  COMPLETED
  FAILED
  SUPERSEDED
  CANCELLED
}

enum BuildSource {
  WEBHOOK_OPEN
  WEBHOOK_SYNC
  WEBHOOK_REOPEN
  MANUAL_REBUILD
  DEV_SIMULATION
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
  DUPLICATE
}

model User {
  id        String    @id @default(cuid())
  githubId  String    @unique
  name      String?
  email     String?   @unique
  avatarUrl String?
  projects  Project[] @relation("UserProjects")
  tier      UserTier  @default(FREE)
}

model Project {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation("UserProjects", fields: [userId], references: [id], onDelete: Cascade)
  repoOwner     String
  repoName      String
  webhookSecret String
  accessToken   String?
  webhookId     String?
  previews      Preview[]         @relation("ProjectPreviews")
  webhookDeliveries WebhookDelivery[] @relation("ProjectWebhookDeliveries")

  @@index([userId])
  @@index([repoOwner, repoName])
}

model Preview {
  id               String          @id @default(cuid())
  projectId        String
  project          Project         @relation("ProjectPreviews", fields: [projectId], references: [id], onDelete: Cascade)
  prNumber         Int
  status           String
  url              String?
  buildLogs        String?
  containerName    String?
  port             Int?
  buildNumber      Int             @default(1)
  buildStartedAt   DateTime?
  buildCompletedAt DateTime?
  metrics          PreviewMetric[]

  activeBuildId     String?
  activeBuild       Build?           @relation("ActivePreviewBuild", fields: [activeBuildId], references: [id], onDelete: SetNull)
  latestBuildId     String?
  desiredCommitSha  String?
  deployedCommitSha String?
  builds            Build[]          @relation("PreviewBuildHistory")
  portAllocations   PortAllocation[] @relation("PreviewPortAllocations")

  @@unique([projectId, prNumber])
  @@index([status])
  @@index([port])
}

model Build {
  id             String      @id @default(cuid())
  previewId      String
  preview        Preview     @relation("PreviewBuildHistory", fields: [previewId], references: [id], onDelete: Cascade)
  buildNumber    Int
  commitSha      String
  commitMessage  String?
  branch         String
  source         BuildSource @default(WEBHOOK_SYNC)
  status         BuildStatus @default(QUEUED)
  attempt        Int         @default(1)
  maxAttempts    Int         @default(3)
  queuedAt       DateTime    @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  cancelledAt    DateTime?
  workerId       String?
  leaseExpiresAt DateTime?
  imageTag       String?
  containerName  String?
  port           Int?
  buildLogs      String?
  errorMessage   String?
  exitCode       Int?

  activeForPreviews Preview[]       @relation("ActivePreviewBuild")
  portAllocation    PortAllocation?

  @@unique([previewId, buildNumber])
  @@index([previewId, status])
  @@index([status, queuedAt])
  @@index([workerId, leaseExpiresAt])
}

model PreviewMetric {
  id String @id @default(cuid())

  previewId String
  preview   Preview @relation(fields: [previewId], references: [id], onDelete: Cascade)

  cpu    Float
  memory BigInt

  networkRx BigInt?
  networkTx BigInt?

  createdAt DateTime @default(now())

  @@index([previewId, createdAt])
}

model WebhookDelivery {
  id           String        @id @default(cuid())
  deliveryId   String        @unique
  eventType    String
  action       String?
  projectId    String?
  project      Project?      @relation("ProjectWebhookDeliveries", fields: [projectId], references: [id], onDelete: SetNull)
  prNumber     Int?
  commitSha    String?
  status       WebhookStatus @default(RECEIVED)
  receivedAt   DateTime      @default(now())
  processedAt  DateTime?
  errorMessage String?

  @@index([deliveryId])
  @@index([projectId, prNumber])
  @@index([receivedAt])
}

model PortAllocation {
  port           Int       @id
  previewId      String?
  preview        Preview?  @relation("PreviewPortAllocations", fields: [previewId], references: [id], onDelete: SetNull)
  buildId        String?   @unique
  build          Build?    @relation(fields: [buildId], references: [id], onDelete: SetNull)
  tier           UserTier  @default(FREE)
  isAllocated    Boolean   @default(false)
  allocatedAt    DateTime?
  lastVerifiedAt DateTime  @default(now())

  @@index([tier, isAllocated])
  @@index([previewId])
}
